generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  BUYER
  SELLER
  MODERATOR
  ADMIN
}
enum KycStatus {
  PENDING
  CLEARED
  REJECTED
}
enum PaymentIntentType {
  HOLD
  PAYOUT
  REFUND
}
enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}
enum LedgerEntryType {
  ESCROW_FUNDED
  PLATFORM_FEE
  SELLER_PAYOUT
  BUYER_REFUND
}
enum BankWebhookStatus {
  RECEIVED
  PROCESSED
  REJECTED
}
enum OutboxStatus {
  PENDING
  PROCESSING
  PUBLISHED
  FAILED
}

model User {
  id String @id @default(uuid()) @db.Uuid
  externalId String? @unique
  roles UserRole[] @default([BUYER])
  kycStatus KycStatus @default(PENDING)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  boughtDeals EscrowDeal[] @relation("BuyerDeals")
  soldDeals EscrowDeal[] @relation("SellerDeals")
  statusChanges EscrowStatusHistory[]
  openedDisputes DisputeCase[] @relation("OpenedDisputes")
}

model EscrowDeal {
  id String @id @default(uuid()) @db.Uuid
  orderId String @unique @db.Uuid
  buyerId String @db.Uuid
  sellerId String @db.Uuid
  status String @default("awaiting_payment") @db.VarChar(40)
  amount Decimal @db.Decimal(18, 2)
  applicationFee Decimal @db.Decimal(18, 2)
  totalEscrowed Decimal @db.Decimal(18, 2)
  currency String @default("KZT") @db.VarChar(3)
  expiresAt DateTime?
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  buyer User @relation("BuyerDeals", fields: [buyerId], references: [id], onDelete: Restrict)
  seller User @relation("SellerDeals", fields: [sellerId], references: [id], onDelete: Restrict)
  statusHistory EscrowStatusHistory[]
  paymentTransactions PaymentTransaction[]
  ledgerEntries LedgerEntry[]
  bankWebhookEvents BankWebhookEvent[]
  termsSnapshot TermsSnapshot?
  dispute DisputeCase?
  @@index([buyerId, status])
  @@index([sellerId, status])
  @@index([status, expiresAt])
}

model EscrowStatusHistory {
  id String @id @default(uuid()) @db.Uuid
  escrowId String @db.Uuid
  previousStatus String? @db.VarChar(40)
  newStatus String @db.VarChar(40)
  triggerEvent String @db.VarChar(80)
  actorId String? @db.Uuid
  metadata Json?
  changedAt DateTime @default(now())
  escrow EscrowDeal @relation(fields: [escrowId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  @@index([escrowId, changedAt])
}

model PaymentTransaction {
  id String @id @default(uuid()) @db.Uuid
  escrowId String @db.Uuid
  intentType PaymentIntentType
  status PaymentStatus
  amount Decimal @db.Decimal(18, 2)
  currency String @db.VarChar(3)
  provider String @db.VarChar(40)
  providerTxId String?
  idempotencyKey String @unique
  metadata Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  escrow EscrowDeal @relation(fields: [escrowId], references: [id], onDelete: Restrict)
  @@index([escrowId, createdAt])
  @@index([provider, providerTxId])
}

model LedgerEntry {
  id String @id @default(uuid()) @db.Uuid
  escrowId String @db.Uuid
  type LedgerEntryType
  debitAccount String @db.VarChar(100)
  creditAccount String @db.VarChar(100)
  amount Decimal @db.Decimal(18, 2)
  currency String @db.VarChar(3)
  reference String @db.VarChar(160)
  idempotencyKey String @unique
  metadata Json?
  createdAt DateTime @default(now())
  escrow EscrowDeal @relation(fields: [escrowId], references: [id], onDelete: Restrict)
  @@index([escrowId, createdAt])
}

model TermsSnapshot {
  id String @id @default(uuid()) @db.Uuid
  escrowId String @unique @db.Uuid
  listingStateAtPurchase Json
  agreementFlags Json
  lockedAt DateTime @default(now())
  escrow EscrowDeal @relation(fields: [escrowId], references: [id], onDelete: Restrict)
}

model DisputeCase {
  id String @id @default(uuid()) @db.Uuid
  escrowId String @unique @db.Uuid
  openedById String @db.Uuid
  reason String
  evidence Json?
  status String @default("opened") @db.VarChar(40)
  resolutionNotes String?
  createdAt DateTime @default(now())
  resolvedAt DateTime?
  escrow EscrowDeal @relation(fields: [escrowId], references: [id], onDelete: Restrict)
  openedBy User @relation("OpenedDisputes", fields: [openedById], references: [id], onDelete: Restrict)
}

model BankWebhookEvent {
  id String @id @default(uuid()) @db.Uuid
  escrowId String? @db.Uuid
  provider String @db.VarChar(40)
  eventId String @db.VarChar(160)
  type String @db.VarChar(80)
  payload Json
  payloadHash String @db.VarChar(64)
  status BankWebhookStatus @default(RECEIVED)
  errorMessage String?
  processedAt DateTime?
  createdAt DateTime @default(now())
  escrow EscrowDeal? @relation(fields: [escrowId], references: [id], onDelete: Restrict)
  @@unique([provider, eventId])
  @@index([status, createdAt])
}

model OutboxEvent {
  id String @id @default(uuid()) @db.Uuid
  aggregateType String @db.VarChar(80)
  aggregateId String @db.VarChar(160)
  eventType String @db.VarChar(120)
  payload Json
  status OutboxStatus @default(PENDING)
  attempts Int @default(0)
  availableAt DateTime @default(now())
  lockedAt DateTime?
  lockedBy String? @db.VarChar(120)
  publishedAt DateTime?
  lastError String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, availableAt])
  @@index([aggregateType, aggregateId, createdAt])
}
